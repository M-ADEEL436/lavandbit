# Copy this file to .env.local and fill in the values.
#   cp .env.example .env.local
#
# With nothing set here the lead form still works in development — leads are
# logged to the server console. In production it refuses the submission and
# tells the visitor to email instead, rather than silently dropping the lead.
# Configure at least one delivery channel before going live.

# ---------------------------------------------------------------------------
# Option 1 (recommended): email each lead via Resend — https://resend.com
# ---------------------------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
LEAD_NOTIFY_EMAIL=sales@lavandbit.com

# Must be an address on a domain you have verified in Resend.
# Until the domain is verified you can only send from onboarding@resend.dev.
LEAD_FROM_EMAIL="Lavandbit Leads <leads@lavandbit.com>"

# ---------------------------------------------------------------------------
# Option 2: POST each lead as JSON to a CRM, Zapier or Make webhook.
# Can run alongside Resend — both fire if both are set.
# ---------------------------------------------------------------------------
# LEAD_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/xxxxxxx/xxxxxxx

# ---------------------------------------------------------------------------
# Option 3: SMTP instead of Resend.
# Not wired up by default — replace sendViaResend() in src/app/api/lead/route.ts
# with a nodemailer transport using these values.
# ---------------------------------------------------------------------------
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# ---------------------------------------------------------------------------
# Analytics — add the GA4 measurement ID to the layout before launch so the
# /thank-you conversion event has somewhere to land.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
